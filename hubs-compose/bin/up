#!/usr/bin/env bash
set -euo pipefail
basedir=$(cd "$(dirname "$0")/.." && pwd)
if [[ -z "${PRIVATE_NETWORK_IP:-}" ]]; then
  case "$OSTYPE" in
    linux*) PRIVATE_NETWORK_IP=$(ip -4 route get 1.1.1.1 | awk '{for(i=1;i<=NF;i++) if($i=="src") {print $(i+1); exit}}') ;;
    darwin*) iface=$(route -n get default | awk '/interface:/ {print $2; exit}')
             PRIVATE_NETWORK_IP=$(ipconfig getifaddr "$iface") ;;
    *) echo 'Set PRIVATE_NETWORK_IP to your computer LAN IPv4 address before running bin/up.' >&2; exit 1 ;;
  esac
fi
[[ -n "$PRIVATE_NETWORK_IP" ]] || { echo 'Cannot determine PRIVATE_NETWORK_IP.' >&2; exit 1; }
export PRIVATE_NETWORK_IP
bash "$basedir/bin/setup-local-keys"
mutagen daemon start
mutagen-compose -f "$basedir/docker-compose.yml" up --build --detach
