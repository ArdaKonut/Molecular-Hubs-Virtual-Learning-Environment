# Auto detect text files and perform LF normalization
* text=auto
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text

# Preserve Unix line endings for shell scripts
*.sh text eol=lf
hubs-compose/bin/** text eol=lf

# Local development helpers and configuration
hubs-compose/files/conditional-npm-ci text eol=lf
hubs-compose/services/reticulum/container/trapped-mix text eol=lf
hubs-compose/services/hubs/admin/webpack.config.js text eol=lf
hubs-compose/services/hubs/webpack.config.js text eol=lf
hubs-compose/services/reticulum/config/dev.exs text eol=lf

hubs-compose/services/spoke/webpack.config.js text eol=lf

.gitattributes text eol=lf
