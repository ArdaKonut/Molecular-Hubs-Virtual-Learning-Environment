#!/usr/bin/env python3
"""Manage the existing production deployment without initializing new volumes."""

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parents[1]
project = "molecular-hubs-production"

# Public config comes from Git; private files stay in --runtime.
os.environ["OCI_PUBLIC_CONFIG_DIR"] = str(root / "config")

parser = argparse.ArgumentParser()
parser.add_argument("--runtime", type=Path, required=True)
parser.add_argument(
    "action",
    choices=["check", "status", "logs", "up", "start", "stop", "restart"]
)
parser.add_argument("services", nargs="*")
args = parser.parse_args()

allowed = {"db", "hubs", "spoke", "reticulum", "dialog", "postgrest", "proxy"}

if not set(args.services).issubset(allowed):
    sys.exit("Unknown service name.")

runtime = args.runtime.expanduser().resolve()
if not runtime.is_dir():
    sys.exit("Runtime directory does not exist.")

files = [
    "compose.yaml",
    "compose.static.yaml",
    "compose.backend.yaml",
    "compose.dialog.yaml",
    "compose.postgrest.yaml",
    "compose.proxy.yaml",
]

command = [
    "docker", "compose",
    "--project-name", project,
    "--project-directory", str(runtime),
    "--env-file", "/dev/null",
]

for filename in files:
    command.extend(["-f", str(root / filename)])

def capture(arguments):
    result = subprocess.run(arguments, capture_output=True, text=True)
    if result.returncode:
        sys.exit(
            "Validation command failed. Check Docker access and runtime files. "
            "Command output withheld to protect secrets."
        )
    return result.stdout

config = json.loads(capture(command + ["config", "--format", "json"]))

if set(config["services"]) != allowed:
    sys.exit("Unexpected service list.")

expected_volumes = {
    "pgdata": project + "_pgdata",
    "retstorage": project + "_retstorage-migrated",
}

for key, expected in expected_volumes.items():
    volume = config["volumes"][key]
    if volume.get("name") != expected or not volume.get("external"):
        sys.exit("Expected an explicit external volume: " + key)

if args.action in {"check", "up", "start", "restart"}:
    for volume in config["volumes"].values():
        capture(["docker", "volume", "inspect", volume["name"]])

    for name, service in config["services"].items():
        if name in {"db", "reticulum", "postgrest", "hubs", "spoke"}:
            if service.get("ports"):
                sys.exit("Unexpected public port mapping: " + name)

        image = json.loads(capture([
            "docker", "image", "inspect", service["image"]
        ]))[0]

        if image.get("Os") != "linux" or image.get("Architecture") != "arm64":
            sys.exit("Expected an existing linux/arm64 image: " + name)

        for mount in service.get("volumes", []):
            if mount["type"] == "bind":
                if not Path(mount["source"]).exists():
                    sys.exit("Missing runtime file or directory: " + mount["source"])

    for secret in config.get("secrets", {}).values():
        if not Path(secret["file"]).is_file():
            sys.exit("A required Compose secret file is missing.")

if args.action == "check":
    print("Deployment preflight passed. No services changed.")
    sys.exit(0)

operations = {
    "status": ["ps", "--all"],
    "logs": ["logs", "--tail", "100"],
    "up": ["up", "--detach", "--no-build", "--pull", "never"],
    "start": ["start"],
    "stop": ["stop"],
    "restart": ["restart"],
}

result = subprocess.run(command + operations[args.action] + args.services)
sys.exit(result.returncode)
